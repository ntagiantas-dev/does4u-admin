# ============================================
# DOES4U ADMIN — ENV EXAMPLE
# ============================================
# Copy to .env and fill in real values.
# In production (Streamlit Cloud / Render),
# the same keys go into st.secrets instead.
# ============================================

# Content provider for blog generation.
# Values: jina | tavily
# Default: jina
CONTENT_PROVIDER=jina

# API keys (also work via st.secrets in Streamlit).
JINA_API_KEY=your_jina_key_here
OPENAI_API_KEY=your_openai_key_here

# Required only when CONTENT_PROVIDER=tavily.
# Get one at: https://tavily.com
TAVILY_API_KEY=your_key_here
